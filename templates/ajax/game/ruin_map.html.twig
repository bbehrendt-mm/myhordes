<hordes-map-e-ruin
        id="e-map" data-react-mount="e-map"
        data-etag="{{ date().timestamp }}"
        data-origin="{{ zone.zone.id }}"
        data-skin="{{ prototype.explorableSkin }}"
        data-name="{{ map.name|trans({},'names') }}"
        data-reload="{{ path('exploration_dashboard') }}"
></hordes-map-e-ruin>