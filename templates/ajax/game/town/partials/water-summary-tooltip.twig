<div class="tooltip help">
    {{'Ces chantiers consomment de l\'eau du puits chaque nuit. Si la ville manque d\'eau, ils ne pourront pas fonctionner correctement.'|trans({}, 'game')|raw}}
    <table>
        {% for info in summary.buildings %}
        <tr>
            <td><img src="{{ asset('build/images/building/' ~ info.icon ~ '.gif') }}" /></td>
            <td>{{ info.label|trans({}, 'buildings') }}</td>
            <td>{{ info.water_consumed }} <img src="{{ asset('build/images/status/status_thirst1.gif') }}" /></td>
            <td>
                {% if info.active %}
                    <img src="{{ asset('build/images/icons/done.png') }}" />
                {% else %}
                    <img src="{{ asset('build/images/icons/warning_anim.gif') }}" />
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </table>
</div>